#
# Arcturus solo-warlock server — recommended config overrides
#
# Copy each module's *.conf.dist from modules/*/conf/ into your server conf/ directory,
# then merge the relevant sections below. Keys here override defaults called out by
# module audits (utility, combat, playerbots integration).
#

####################################################################################################
# worldserver.conf
####################################################################################################

EnablePlayerSettings = 1
DBC.EnforceItemAttributes = 0
AccountInstancesPerHour = 100
Rate.Corpse.Decay.Looted = 0.01
Updates.EnableDatabases = 7

# Creature kill XP (quests/explore stay at 1x unless you change them too)
Rate.XP.Kill = 3

# Allow learning every primary profession from trainers (still learn/rank normally).
# Range 0-11; secondaries (First Aid/Cooking/Fishing) are already unlimited.
# MUST be present in the live worldserver.conf (or AC_MAX_PRIMARY_TRADE_SKILL).
# .dist alone is NOT auto-applied. If this stays at the stock value 2, the client
# shows "you can only learn two professions" and greys out new primaries.
# Playerbots are forced back to 2 free primary slots on login by arcturus_trade_skills.
MaxPrimaryTradeSkill = 11

# Warlocks can buy all weapon skills from weapon masters (cloth armor unchanged).
# Requires rebuild; disable needs a worldserver restart (DBC patch is applied at startup).
# Client Skills pane still needs SkillRaceClassInfo.dbc in a late MPQ (server SetSkill alone
# is not enough). Regenerate: WoW-Spell-Editor/Arcturus/patch_skillraceclassinfo_warlock_weapons.py
# → Data/enUS/patch-enUS-z.MPQ → clear Cache/WDB. Keep WEAPON_SKILLS in sync with that script.
Arcturus.WarlockWeaponTrainers.Enable = 1

EndlessInstances.Enable = 1
WarlockDemonicEmpowerment.Enable = 1
# Explicit keys silence Config "Missing property" spam on every kill/login under bots.
# Merge into live env/dist/etc/worldserver.conf (gitignored) or rely on AC_* env in
# docker-compose.override.yml — .dist alone is not auto-applied.
# PerKill rates are floats; pet flats use min(current, MaxSoulsApplied). 0 = uncapped.
WarlockDemonicEmpowerment.PerKill.Stamina = 0.2
WarlockDemonicEmpowerment.PerKill.Strength = 0.1
WarlockDemonicEmpowerment.PerKill.Agility = 0.1
WarlockDemonicEmpowerment.PerKill.Intellect = 0.1
WarlockDemonicEmpowerment.PerKill.Spirit = 0.1
WarlockDemonicEmpowerment.PerKill.AttackPower = 0.1
WarlockDemonicEmpowerment.PerKill.SpellPower = 0.05
WarlockDemonicEmpowerment.PerKill.Armor = 0.5
WarlockDemonicEmpowerment.PerKill.MaxSoulsApplied = 10000
WarlockDemonicEmpowerment.Tempering.Stamina = 2
WarlockDemonicEmpowerment.Tempering.Intellect = 2
WarlockDemonicEmpowerment.Tempering.SpellPower = 3
WarlockDemonicEmpowerment.Tempering.ManaPer5 = 1
WarlockDemonicEmpowerment.Tempering.SoulsPerTier = 25
WarlockDemonicEmpowerment.Tempering.MaxTiers = 0
WarlockDemonicEmpowerment.AnnounceEveryNKills = 100

# Corrupted Blood (90042) — Soul Reaver (5000 souls) passive.
# Stat values live in spell_dbc (90042 / 90043), not here: tune them with an UPDATE.
# VisualSpellId is the animation seam — set it to a spell_dbc row with the visual you
# want and the passive casts it on apply. 0 = no extra visual (the default today).
Arcturus.CorruptedBlood.VisualSpellId = 0
# Creepy self-whispers from your own blood. Pure flavor; rolled on the passive's 30s tick.
Arcturus.CorruptedBlood.Whispers.Enable = 1
Arcturus.CorruptedBlood.Whispers.MinSeconds = 240
Arcturus.CorruptedBlood.Whispers.MaxSeconds = 900

####################################################################################################
# AutoBalance.conf  (modules/mod-autobalance/conf/)
####################################################################################################
#
# Arcturus fairness model:
#   Warlock + permanent pet + Demonic Empowerment (souls → pet flats, lifetime → tempering)
#   are the "party". Do NOT scale enemies down for 1 human in the instance — that made
#   dungeons/raids trivial once souls stacked. Hold full instance stats (CurveFloor=Ceiling=1),
#   then apply a light StatModifier premium so stock dungeon tuning still challenges DE power.
#   Tune Global/Boss.* up or down if early (0 souls) feels too hard or late feels too soft.
#
AutoBalance.Enable.Global = 1
AutoBalance.playerCountDifficultyOffset = 0
AutoBalance.MinPlayers = 1
AutoBalance.MinPlayers.Raid = 1
AutoBalance.RewardScaling.XP = 1
AutoBalance.reward.enable = 0
AutoBalance.PlayerChangeNotify = 0
AutoBalanceAnnounce.enable = 0

# Always use full instance baseline (no solo downscale).
AutoBalance.InflectionPoint.CurveFloor = 1.0
AutoBalance.InflectionPoint.CurveCeiling = 1.0
AutoBalance.InflectionPointHeroic.CurveFloor = 1.0
AutoBalance.InflectionPointHeroic.CurveCeiling = 1.0
AutoBalance.InflectionPointRaid.CurveFloor = 1.0
AutoBalance.InflectionPointRaid.CurveCeiling = 1.0
AutoBalance.InflectionPointRaidHeroic.CurveFloor = 1.0
AutoBalance.InflectionPointRaidHeroic.CurveCeiling = 1.0

# Premium on top of full-strength tuning (trash slightly less than bosses).
AutoBalance.StatModifier.Global = 1.5
AutoBalance.StatModifier.Boss.Global = 1.75
AutoBalance.StatModifierHeroic.Global = 1.5
AutoBalance.StatModifierHeroic.Boss.Global = 1.75
AutoBalance.StatModifierRaid.Global = 1.5
AutoBalance.StatModifierRaid.Boss.Global = 1.75
AutoBalance.StatModifierRaidHeroic.Global = 1.5
AutoBalance.StatModifierRaidHeroic.Boss.Global = 1.75

####################################################################################################
# individualProgression.conf  (modules/mod-individual-progression/conf/)
####################################################################################################

IndividualProgression.Enable = 1
IndividualProgression.SimpleConfigOverride = 1
IndividualProgression.BotAccountsRegex = "^rndbot.*"
IndividualProgression.BotOnlyAdjustments = 0
IndividualProgression.VanillaPowerAdjustment = 1
IndividualProgression.VanillaHealingAdjustment = 1
IndividualProgression.doableNaxx40Bosses_4H = 1
IndividualProgression.doableNaxx40Bosses_Gluth = 1
IndividualProgression.doableNaxx40Bosses_Patchwerk = 1
IndividualProgression.doableNaxx40Bosses_Razuvious = 1

####################################################################################################
# mod_aoe_loot.conf
####################################################################################################

AOELoot.Enable = 1
AOELoot.Group = 1
AOELoot.Range = 55.0
AOELoot.Message = 0

####################################################################################################
# transmog.conf
####################################################################################################

Transmogrification.Enable = 1
Transmogrification.UseCollectionSystem = 1
Transmogrification.EnablePortable = 1
Transmogrification.ScaledCostModifier = 0.0
Transmogrification.CopperCost = 0
Transmogrification.AllowLegendary = 1
Transmogrification.EnablePlus = 0

####################################################################################################
# mod_ahbot.conf  — requires a real (non-bot) character GUID
####################################################################################################

# AuctionHouseBot.GUIDs = <your_dedicated_ah_bot_guid>
# AuctionHouseBot.EnableSeller = true
# AuctionHouseBot.Buyer.Enabled = false
# AuctionHouseBot.DisabledCustomItemIDs =
# AuctionHouseBot.Alliance.MinItems = 800
# AuctionHouseBot.Alliance.MaxItems = 1200

####################################################################################################
# mod_ollama_chat.conf  — LLM bot talk (requires Ollama; prefer compose service ac-ollama)
####################################################################################################

OllamaChat.Enable = 1
# In Docker: http://ac-ollama:11434/api/generate (see conf/dist/docker-compose.override.yml).
# Bare-metal worldserver + host Ollama: http://localhost:11434/api/generate
OllamaChat.Url = http://ac-ollama:11434/api/generate
OllamaChat.Model = llama3.2:1b
OllamaChat.NumPredict = 40
OllamaChat.MaxConcurrentQueries = 2
OllamaChat.DebugEnabled = 0
OllamaChat.EnableRandomChatter = 1
OllamaChat.EnableEventChatter = 0
OllamaChat.EnableGuildRandomAmbientChatter = 0
OllamaChat.EnableWhisperReplies = 1
OllamaChat.MinRandomInterval = 90
OllamaChat.MaxRandomInterval = 180
OllamaChat.RandomChatterRealPlayerDistance = 40

# Keep canned playerbot chatter off so LLM owns the talk (playerbots.conf.dist already
# sets these to 0). Uncomment only if you want both systems at once:
# AiPlayerbot.EnableBroadcasts = 0
# AiPlayerbot.RandomBotTalk = 0
# AiPlayerbot.RandomBotEmote = 0
# AiPlayerbot.RandomBotSuggestDungeons = 0
# AiPlayerbot.EnableGreet = 0
# AiPlayerbot.GuildFeedback = 0
# AiPlayerbot.RandomBotSayWithoutMaster = 0

####################################################################################################
# playerbots.conf  — see modules/mod-playerbots/conf/playerbots.conf.dist for Arcturus defaults
####################################################################################################

# AiPlayerbot.DisableWarlockLogin = 1  (blocks randombot + addclass warlock)
