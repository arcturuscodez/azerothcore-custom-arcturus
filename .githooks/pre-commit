#!/bin/sh
# Arcturus hard commit gate. Installed via: git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# GUI Git (Cursor/VS Code) often inherits a stale PATH from explorer.exe that
# lacks conda even after User PATH is updated. Prefer known install locations.
_py_candidates() {
  # Absolute interpreters first (Git Bash / MSYS paths on Windows).
  printf '%s\n' \
    "$USERPROFILE/miniconda3/python.exe" \
    "$HOME/miniconda3/python.exe" \
    "$USERPROFILE/anaconda3/python.exe" \
    "$HOME/anaconda3/python.exe" \
    "$LOCALAPPDATA/miniconda3/python.exe" \
    "$USERPROFILE/Miniconda3/python.exe" \
    "$USERPROFILE/Anaconda3/python.exe"
  # PATH-based names last (skip broken Windows Store stubs via import check).
  printf '%s\n' py python3 python
}

run_py() {
  cand=
  for cand in $(_py_candidates); do
    case "$cand" in
      py)
        if command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
          py -3 "$@"
          return
        fi
        ;;
      python3|python)
        if command -v "$cand" >/dev/null 2>&1 && "$cand" -c "import sys" >/dev/null 2>&1; then
          "$cand" "$@"
          return
        fi
        ;;
      *)
        if [ -x "$cand" ] && "$cand" -c "import sys" >/dev/null 2>&1; then
          "$cand" "$@"
          return
        fi
        # Git Bash: -x can fail on .exe even when runnable; try anyway.
        if [ -f "$cand" ] && "$cand" -c "import sys" >/dev/null 2>&1; then
          "$cand" "$@"
          return
        fi
        ;;
    esac
  done
  echo "ERROR: no working Python found for Arcturus pre-commit gate (tried py -3, python3, python, and common conda paths)" >&2
  exit 1
}

if git diff --cached --name-only | grep -q '^tests/arcturus_gates/'; then
  if [ "${ARCTURUS_UNLOCK_GATES:-}" != "1" ]; then
    echo "ERROR: staged changes under tests/arcturus_gates/ are forbidden." >&2
    echo "Suite is frozen. Human unlock: ARCTURUS_UNLOCK_GATES=1 then re-lock with" >&2
    echo "  py -3 tools/lock_arcturus_gates.py --lock" >&2
    exit 1
  fi
fi

run_py tools/lock_arcturus_gates.py --verify
run_py tests/arcturus_gates/run_all.py

exit 0
