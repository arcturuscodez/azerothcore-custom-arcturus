#!/bin/sh
# Arcturus hard commit gate. Installed via: git config core.hooksPath .githooks
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

run_py() {
  # Avoid the Windows Store `python` stub (command -v succeeds, runtime fails).
  if command -v py >/dev/null 2>&1 && py -3 -c "import sys" >/dev/null 2>&1; then
    py -3 "$@"
    return
  fi
  if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
    python3 "$@"
    return
  fi
  if command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
    python "$@"
    return
  fi
  echo "ERROR: no working Python found for Arcturus pre-commit gate (tried py -3, python3, python)" >&2
  exit 1
}

if git diff --cached --name-only | grep -q '^tests/arcturus_gates/'; then
  if [ "${ARCTURUS_UNLOCK_GATES:-}" != "1" ]; then
    echo "ERROR: staged changes under tests/arcturus_gates/ are forbidden." >&2
    echo "Suite is frozen. Human unlock: ARCTURUS_UNLOCK_GATES=1 then re-lock with" >&2
    echo "  py -3 tools/lock_arcturus_gates.py --lock" >&2
    exit 1
  fi
fi

run_py tools/lock_arcturus_gates.py --verify
run_py tests/arcturus_gates/run_all.py

exit 0
