{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/require-arcturus-gates.ps1",
        "matcher": "^git(\\.exe)?\\s+commit\\b",
        "failClosed": true,
        "timeout": 30
      }
    ]
  }
}
